# ==========================================
# DEPENDENCIAS
# ==========================================
# node_modules/ contiene TODAS las dependencias descargadas.
# No se commitea porque:
# 1. Puede pesar cientos de MB
# 2. Se regenera con "pnpm install" usando el lockfile
node_modules/

# ==========================================
# ARCHIVOS DE BUILD / COMPILACIÓN
# ==========================================
# Generados por "tsc" (TypeScript) y "sass" (SCSS).
# No se commitean porque se pueden regenerar desde el código fuente.
dist/

# ==========================================
# LOGS
# ==========================================
*.log
npm-debug.log*
pnpm-debug.log*

# ==========================================
# SISTEMA OPERATIVO
# ==========================================
# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Linux
*~

# ==========================================
# EDITORES / IDE
# ==========================================
# VS Code (settings locales del usuario, no del proyecto)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (WebStorm, IntelliJ)
.idea/

# ==========================================
# VARIABLES DE ENTORNO
# ==========================================
# NUNCA commitear archivos con secretos (tokens, passwords, API keys).
# .env.example sí se commitea como plantilla.
.env
.env.local
.env.*.local

# ==========================================
# CACHE Y TEMPORALES
# ==========================================
.cache/
.tmp/
.temp/
*.tsbuildinfo
