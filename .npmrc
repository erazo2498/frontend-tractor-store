# ==========================================
# .npmrc — Configuración del gestor de paquetes
# ==========================================
# Este archivo configura cómo npm/pnpm descarga e instala dependencias.
# Se lee AUTOMÁTICAMENTE al ejecutar npm install o pnpm install.
# Es especialmente importante en entornos corporativos con registros privados.

# ------------------------------------------
# REGISTRO (Registry)
# ------------------------------------------
# El registro es el "servidor" de donde se descargan los paquetes.
# Por defecto apunta al registro público de npm.
registry=https://registry.npmjs.org/

# En una empresa, tendrías un registro privado (Nexus, Artifactory, GitHub Packages).
# Puedes definir un registro específico por scope:
#
# Ejemplo con Artifactory corporativo:
# @tractor-store:registry=https://npm.internal.company.com/
#
# Ejemplo con GitHub Packages:
# @tractor-store:registry=https://npm.pkg.github.com/

# ------------------------------------------
# AUTENTICACIÓN
# ------------------------------------------
# Para registros privados, necesitas un token de autenticación.
# NUNCA hardcodees el token en el archivo. Usa variables de entorno:
#
# //npm.internal.company.com/:_authToken=${NPM_TOKEN}
#
# En CI/CD (GitHub Actions), configurarías NPM_TOKEN como un secret.
# Localmente, puedes hacer: export NPM_TOKEN=tu_token_aqui

# ------------------------------------------
# COMPORTAMIENTO DE INSTALACIÓN
# ------------------------------------------

# save-exact: guarda versiones exactas en package.json (sin ^ ni ~)
# Esto mejora la reproducibilidad: todos instalan EXACTAMENTE la misma versión.
# Sin esto, npm usa "^" por defecto, lo cual permite updates de MINOR.
save-exact=true

# ------------------------------------------
# SEMVER (Semantic Versioning) — Referencia rápida
# ------------------------------------------
# La versión sigue el formato: MAJOR.MINOR.PATCH
#
#   MAJOR (1.x.x → 2.x.x): Cambios que ROMPEN compatibilidad (breaking changes)
#   MINOR (1.0.x → 1.1.x): Nuevas funcionalidades COMPATIBLES hacia atrás
#   PATCH (1.0.0 → 1.0.1): Correcciones de bugs
#
# Rangos en package.json:
#   "~5.7.0"  → Acepta patches:    5.7.0, 5.7.1, 5.7.9 (NO 5.8.0)
#   "^5.7.0"  → Acepta minor+patch: 5.7.0, 5.8.0, 5.9.9 (NO 6.0.0)
#   "5.7.0"   → Versión exacta:     SOLO 5.7.0
#
# ¿Cuál usar? En librerías de bajo riesgo usa ~, en producción crítica usa exactas.
